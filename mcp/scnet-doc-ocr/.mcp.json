{
  "name": "scnet-ocr-mcp",
  "version": "0.1.0",
  "description": "MCP server for Scnet OCR Document Intelligence Service",
  "vendor": "Scnet",
  "license": "MIT",
  "runtime": "node",
  "homepage": "https://github.com/yourname/scnet-ocr-mcp",
  "entry": {
    "command": "npx",
    "args": ["-y", "scnet-ocr-mcp"]
  },
  "tools": [
    {
      "name": "ocr_submit_task",
      "description": "提交文档进行 OCR 识别。需提供文档的公网可访问 URL，返回 task_id 用于后续查询。"
    },
    {
      "name": "ocr_query_result",
      "description": "根据任务 ID 查询 OCR 任务的状态和结果。"
    },
    {
      "name": "ocr_submit_and_wait",
      "description": "提交文档进行 OCR 识别并等待结果。便捷方法，合并了提交和轮询操作。"
    }
  ],
  "configuration": {
    "properties": {
      "SCNET_API_KEY": {
        "type": "string",
        "description": "Scnet API 密钥",
        "required": true
      },
      "SCNET_BASE_URL": {
        "type": "string",
        "description": "API 基础地址",
        "default": "https://api.scnet.cn/api/llm/v1/ocrdoc"
      },
      "SCNET_POLL_INTERVAL": {
        "type": "integer",
        "description": "轮询间隔（秒）",
        "default": 5
      },
      "SCNET_MAX_POLL_TIME": {
        "type": "integer",
        "description": "submit_and_wait 最大等待时间（秒）",
        "default": 300
      }
    }
  }
}
